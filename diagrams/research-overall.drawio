        <mxCell id="A" value="01  연구 목적&#10;종판·해면골 강성 변화의 개별 기여와 복합 효과 규명" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F1FB;strokeColor=#6B91B5;strokeWidth=1.5;fontColor=#183C62;fontFamily=Noto Sans CJK KR;fontSize=21;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
