          <mxGeometry x="40" y="72" width="610" height="128" as="geometry" />
        </mxCell>
        <mxCell id="R-local" value="보조 지표  ·  조직별 변형&#10;케이지 접촉면의 투영 영역 아래 동일 관심영역&#10;골성 종판·해면골의 압축 최소주변형률 크기·분포&#10;영역 평균과 국소 분포를 함께 비교" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#B9C9D9;strokeWidth=1.5;fontColor=#20334A;fontFamily=Noto Sans CJK KR;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-RESP">
          <mxGeometry x="690" y="72" width="610" height="128" as="geometry" />
        </mxCell>
        <mxCell id="response-note" value="강성은 400 N 시점의 할선강성으로 정의. 관심영역·가중 방식은 네 조건에서 같게 유지." style="text;rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#62758B;fontFamily=Noto Sans CJK KR;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-RESP">
          <mxGeometry x="40" y="204" width="1260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="section-ANALYSIS" value="" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#F8FAFD;strokeColor=#D0DBE8;strokeWidth=1.5;fontColor=#263A54;fontFamily=Noto Sans CJK KR;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="2044" width="1340" height="276" as="geometry" />
        </mxCell>
        <mxCell id="section-ANALYSIS-title" value="07  결과 비교  |  개별 영향과 상호작용 정량화" style="text;rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#263A54;fontFamily=Noto Sans CJK KR;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="section-ANALYSIS">
          <mxGeometry x="30" y="15" width="1280" height="42" as="geometry" />
        </mxCell>
        <mxCell id="V1" value="개별 영향&#10;종판: R10 − R00&#10;해면골: R01 − R00&#10;기준 대비 변화량·변화율 비교" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#B9C9D9;strokeWidth=1.5;fontColor=#20334A;fontFamily=Noto Sans CJK KR;fontSize=19;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-ANALYSIS">
          <mxGeometry x="40" y="72" width="390" height="112" as="geometry" />
        </mxCell>
        <mxCell id="V2" value="상호작용&#10;I = R11 − R10 − R01 + R00&#10;종판 상태에 따라 해면골 저하의&#10;영향이 얼마나 달라지는지 평가" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E9F1FB;strokeColor=#6B91B5;strokeWidth=1.5;fontColor=#183C62;fontFamily=Noto Sans CJK KR;fontSize=18;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-ANALYSIS">
          <mxGeometry x="475" y="72" width="390" height="112" as="geometry" />
        </mxCell>
        <mxCell id="V3" value="수치 오차와 비교하여 해석&#10;|I|가 오차 대비 충분히 크면 비가산 효과&#10;작으면 선택한 범위에서 가산적 근사&#10;단일 계산값에 유의확률을 부여하지 않음" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#FFF4DE;strokeColor=#D3AB61;strokeWidth=1.5;fontColor=#725116;fontFamily=Noto Sans CJK KR;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-ANALYSIS">
          <mxGeometry x="910" y="72" width="390" height="112" as="geometry" />
        </mxCell>
        <mxCell id="analysis-note" value="R은 같은 지표·같은 관심영역의 결과값. R00=기준, R10=종판만 저하, R01=해면골만 저하, R11=동시 저하.&#10;강성·조직별 변형 지표마다 따로 계산하며, 효과의 방향이나 크기를 미리 확정하지 않음." style="text;rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#62758B;fontFamily=Noto Sans CJK KR;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="section-ANALYSIS">
          <mxGeometry x="40" y="198" width="1260" height="57" as="geometry" />
        </mxCell>
        <mxCell id="analysis-12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#8198AE;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="V1" target="V2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="analysis-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;strokeColor=#8198AE;strokeWidth=2;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="V2" target="V3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="END" value="포스터의 결론 범위&#10;선택한 L4–L5 형상·물성 조합·축압축 조건에서&#10;종판·해면골 탄성계수 변화의 개별 기여와 복합 효과를 설명" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=#E5F2EA;strokeColor=#70A48A;strokeWidth=1.5;fontColor=#204D34;fontFamily=Noto Sans CJK KR;fontSize=23;fontStyle=1;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="180" y="2370" width="1140" height="122" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="실제 파손 순서·파손하중·진행성 침강·굽힘 및 회전 안정성 예측은 이번 결론에 포함하지 않음." style="text;rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#62758B;fontFamily=Noto Sans CJK KR;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="2505" width="1240" height="42" as="geometry" />
        </mxCell>
        <mxCell id="source" value="탄성계수 출처: Zou et al., Global Spine Journal 14(7), 2024 (온라인 2023)  ·  DOI: 10.1177/21925682231166612&#10;연구 전체 흐름: research-overall.drawio  ·  분리 정리: 2026-10-19  ·  수치와 연구 범위는 기존 계획 유지" style="text;rounded=1;arcSize=10;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;strokeWidth=1.5;fontColor=#62758B;fontFamily=Noto Sans CJK KR;fontSize=15;fontStyle=0;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
